{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build with Python Builder",
            "type": "shell",
            "command": "python",
            "args": ["${workspaceFolder}/build_project.py"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "problemMatcher": []
        },
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-G", "Visual Studio 17 2022",
                "-A", "x64",
                "-S", "${workspaceFolder}/build/${input:taskCategory}/${input:taskExample}",
                "-B", "${workspaceFolder}/build/${input:taskCategory}/${input:taskExample}"
            ],
            "group": "build",
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "CMake Build Debug",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/${input:taskCategory}/${input:taskExample}",
                "--config", "Debug"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Clean Build Directory",
            "type": "shell",
            "command": "cmd",
            "args": ["/c", "if exist build rmdir /s /q build"],
            "group": "build",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "taskCategory",
            "type": "pickString",
            "description": "Select category",
            "options": [
                "opencv",
                "ffmpeg", 
                "static_test",
                "testbox",
                "otherdll",
                "armbox"
            ],
            "default": "opencv"
        },
        {
            "id": "taskExample",
            "type": "promptString",
            "description": "Enter example name",
            "default": ""
        }
    ]
}
